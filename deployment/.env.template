# Environment variables for deployment/docker-compose.yml.
#
# Copy this file to .env (already gitignored) and adjust values:
#   cp .env.template .env
#
# docker compose auto-loads ./.env when run from inside this directory
# (cd deployment && make up / docker compose up).

# --- KasmVNC / desktop -------------------------------------------------
VNC_USER=user
VNC_PW=password
VNC_RESOLUTION=1920x1080
VNC_COL_DEPTH=24
VNC_PORT=8443

# --- Authentication ------------------------------------------------------
# Tri-state mode selector (default: basic).
#   basic   -- HTTP Basic Auth on the web endpoint (browser dialog).
#   greeter -- LightDM login form inside the desktop (see docs).
#   none    -- no auth (DEV ONLY -- never expose to network).
KASM_AUTH_MODE=basic

# --- Egress network lockdown (ON by default) ------------------------------
# Comma-separated allowlist: IPv4 addresses, CIDRs, and/or hostnames.
# Leave empty to reach nothing outbound at all.
KASM_EGRESS_ALLOW=
# Set to 0 to disable the nftables egress filter entirely (dev only).
KASM_EGRESS_LOCKDOWN=1

# --- Kasm permission controls (secure-by-default) -------------------------
# Clipboard is OFF in both directions unless explicitly enabled.
# Accepts 1/yes/true/on/enabled; anything else counts as off.
KASM_ALLOW_CLIPBOARD_IN=0    # paste: local machine -> container
KASM_ALLOW_CLIPBOARD_OUT=0   # copy: container -> local machine
KASM_ALLOW_PRIMARY_SELECTION=0  # X primary selection (middle-click paste)
# Byte caps on clipboard payloads (0 = unlimited, only applies when allowed above).
KASM_CLIPBOARD_IN_MAX=0
KASM_CLIPBOARD_OUT_MAX=0
# Anti-spam delay between clipboard ops in ms (0 = none).
KASM_CLIPBOARD_DELAY_MS=0
# Comma-separated MIME allowlist. Empty = KasmVNC's built-in default list.
KASM_CLIPBOARD_MIME_TYPES=
# Watermark text overlay (screenshot deterrent). Supports ${USER} and strftime tokens.
KASM_WATERMARK_TEXT=
# DLP logging level: off | info | verbose.
# WARNING: 'verbose' logs KEYSTROKES AND CLIPBOARD CONTENT to the server log.
KASM_DLP_LOG=off
